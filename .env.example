# Copy this file to `.env.local` and paste values from:
# Firebase Console → Project settings → Your apps → Web app → SDK setup (npm) → firebaseConfig

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=iron-prairie-website
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional – only if you enabled Google Analytics for the web app
# VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA Enterprise site key — public client key)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Stripe Payments Configuration
# Obtain publishable key from Stripe Dashboard -> Developers -> API Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend API Endpoint URL (optional: defaults to relative /api or Firebase Cloud Functions)
VITE_API_BASE_URL=
