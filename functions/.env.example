# Firebase Cloud Functions Environment Configuration
# Set these in your Firebase Functions environment or .env file in functions/

# 1. Stripe Secret Key (from Stripe Dashboard -> Developers -> API Keys)
# Starts with sk_test_... (Sandbox) or sk_live_... (Production)
STRIPE_SECRET_KEY=sk_test_...

# 2. Stripe Webhook Signing Secret (from Stripe Dashboard -> Developers -> Webhooks)
# Starts with whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 3. Payout Account Target
BLUEVINE_ACCOUNT_NAME="Iron Prairie Fabrication Group LLC"
