rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // checkout_leads: written by frontend before Stripe redirect (unauthenticated)
    // Require Firebase App Check + validate shape/size; no client read/update/delete
    match /checkout_leads/{docId} {
      allow create: if request.app != null
        && request.resource.data.keys().hasAll([
          'orderRefId',
          'buyerEmail',
          'createdAt'
        ])
        && request.resource.data.keys().size() <= 40
        && request.resource.data.orderRefId is string
        && request.resource.data.orderRefId.size() > 0
        && request.resource.data.orderRefId.size() <= 80
        && request.resource.data.buyerEmail is string
        && request.resource.data.buyerEmail.size() > 3
        && request.resource.data.buyerEmail.size() <= 254;
      allow read, update, delete: if false;
    }

    // checkout_carts: written/read only by Cloud Functions (Admin SDK). Never client-readable.
    match /checkout_carts/{docId} {
      allow read, write: if false;
    }

    // orders: written by Firebase Cloud Functions (Admin SDK bypasses these rules)
    // notifications: fallback log from Cloud Functions
    match /orders/{docId} {
      allow read, write: if false;
    }

    match /notifications/{docId} {
      allow read, write: if false;
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
